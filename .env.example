# ============================================================================
# VERCEL: COPY EVERY VARIABLE IN THIS BLOCK TO VERCEL → Production
# ============================================================================
# Enter the values from your private .env.local; never upload the file itself.
# For the FIRST deployment, use the current NEXT_PUBLIC_SITE_URL value. After
# Vercel gives you its stable HTTPS URL, replace only NEXT_PUBLIC_SITE_URL with
# the complete URL including https:// (for example, https://your-app.vercel.app)
# and redeploy. NEVER replace NEXT_PUBLIC_SUPABASE_URL with a Vercel
# URL: it must always be your https://<project-ref>.supabase.co project URL.

# Supabase runtime — get these from Supabase → Project Settings → Data API. ------ ABC DEF
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qrstuvwxyz
# Server-only: never rename this to NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_aabbccddeeffgghhiijj

# Email runtime (SMTP)
# Server-only: never add a NEXT_PUBLIC_ prefix.
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Spam check on sign-up and password reset — always on.
# With no keys, the built-in math captcha is used (works with no setup). Optionally set both
# Cloudflare Turnstile keys (https://dash.cloudflare.com → Turnstile) to use Turnstile instead.
# Server-only secrets: never add a NEXT_PUBLIC_ prefix to TURNSTILE_SECRET_KEY or CAPTCHA_SECRET.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: key for signing built-in captcha challenges (any long random string). If empty, a
# key derived from SUPABASE_SERVICE_ROLE_KEY is used.
CAPTCHA_SECRET=

NEXT_PUBLIC_SITE_NAME=E-VetDoc
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_URL=

# ============================================================================
# STOP — DO NOT COPY ANYTHING BELOW THIS LINE TO VERCEL
# These values are for local development, controlled CI, and task tracking.
# ============================================================================

# Local/CI database maintenance only
SUPABASE_PROJECT_ID=abcdefghijklmnop
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.abcdefghijklmnop.supabase.co:5432/postgres

# Playwright end-to-end test accounts (test database only)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_STAFF_EMAIL=
TEST_STAFF_PASSWORD=
TEST_VET_EMAIL=
TEST_VET_PASSWORD=
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
